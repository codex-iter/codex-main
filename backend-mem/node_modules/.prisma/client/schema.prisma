generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  CODEFORCES
  LEETCODE
  GFG
  CODECHEF
  HACKERRANK
  GITHUB
}

enum SyncStatus {
  ok
  failed
  private
  no_data
}

enum DateSource {
  platform
  detected
}

enum DailyActivityKind {
  problems
  submissions
  contributions
}

model Member {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String   @map("display_name")
  isActive    Boolean  @default(true) @map("is_active")
  joinedAt    DateTime @default(now()) @map("joined_at")

  platformAccounts PlatformAccount[]
  solvedProblems   SolvedProblem[]
  dailyActivities  DailyActivity[]

  @@map("members")
}

model PlatformAccount {
  id                  String      @id @default(cuid())
  memberId            String      @map("member_id")
  platform            Platform
  username            String
  baselineDone        Boolean     @default(false) @map("baseline_done")
  consecutiveFailures Int         @default(0) @map("consecutive_failures")
  lastSyncedAt        DateTime?   @map("last_synced_at")
  lastSyncStatus      SyncStatus? @map("last_sync_status")
  lastError           String?     @map("last_error")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, platform])
  @@map("platform_accounts")
}

model SolvedProblem {
  id         String     @id @default(cuid())
  memberId   String     @map("member_id")
  platform   Platform
  problemId  String     @map("problem_id")
  title      String
  difficulty String?
  tags       String[]
  solvedAt   DateTime   @map("solved_at")
  solvedDate DateTime   @map("solved_date") @db.Date
  url        String
  dateSource DateSource @default(platform) @map("date_source")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, platform, problemId])
  @@map("solved_problems")
}

model DailyActivity {
  memberId String
  platform Platform
  date     DateTime          @db.Date
  count    Int
  kind     DailyActivityKind

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, platform, date])
  @@unique([memberId, platform, date])
  @@map("daily_activity")
}

model SyncRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  membersTotal  Int       @default(0) @map("members_total")
  membersOk     Int       @default(0) @map("members_ok")
  membersFailed Int       @default(0) @map("members_failed")
  errorLog      String?   @map("error_log")

  @@map("sync_runs")
}
